{
	"name": "@thoth-dev/tailcast",
	"version": "0.5.1",
	"publishConfig": {
		"access": "public"
	},
	"description": "Peer-to-peer browser screen sharing. No SFU, no TURN, no account, no dependencies.",
	"keywords": [
		"screen-sharing",
		"webrtc",
		"p2p",
		"tailscale",
		"stun",
		"bun"
	],
	"license": "MIT",
	"author": "Gabriel Andreello",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thoth-id/tailcast.git"
	},
	"homepage": "https://github.com/thoth-id/tailcast#readme",
	"bugs": {
		"url": "https://github.com/thoth-id/tailcast/issues"
	},
	"type": "module",
	"bin": {
		"tailcast": "bin/tailcast.mjs",
		"screen-share": "bin/tailcast.mjs"
	},
	"files": [
		"bin/tailcast.mjs",
		"bin/cli.ts",
		"server.ts",
		"stun.ts",
		"public/",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"start": "bun run server.ts",
		"format": "biome check --write ./",
		"format:check": "biome check ./",
		"lint": "biome lint ./",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"bun-types": "^1.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.0"
	},
	"lint-staged": {
		"*.{ts,mts,cts,js,mjs,cjs,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		],
		"*.{html,css,svg}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
